# ============================================================================
# AQuant Git 忽略规则
# ============================================================================

# ---- 敏感信息（严禁提交）----
.env

# ---- Python 缓存与构建产物 ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- 临时诊断脚本（用完即删，防止误提交）----
.tmp_*.py

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- IDE 配置 ----
.idea/
.vscode/
*.swp
*.swo

# ---- 项目配置文件（按需跟踪）----
.coderrules
pytest.ini

# ---- 本地数据与日志（AKShare 缓存、SQLite、回测产物）----
# 修正记录（P4）：data/ 整体忽略会误伤股票池降级链依赖的两个 JSON（快照与手工池），
# 它们需随 git 分发到 Ubuntu VM（见 src/pool_snapshot.py 三级降级链），故加白名单例外。
data/*
!data/industry_pool_snapshot.json
!data/manual_pool.json
cache/
*.db
*.sqlite
*.log
backtest_output/
market_cache.db

# ---- 系统文件 ----
.DS_Store
Thumbs.db
