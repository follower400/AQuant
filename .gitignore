# ============================================================================
# AQuant Git 忽略规则
# ============================================================================

# ---- 敏感信息（严禁提交）----
.env

# ---- Python 缓存与构建产物 ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- IDE 配置 ----
.idea/
.vscode/
*.swp
*.swo

# ---- 本地数据与日志（AKShare 缓存、SQLite、回测产物）----
data/
cache/
*.db
*.sqlite
*.log
backtest_output/

# ---- 系统文件 ----
.DS_Store
Thumbs.db
