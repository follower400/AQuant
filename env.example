# ============================================================================
# 环境变量模板 —— 复制本文件为 .env 后填写真实值
# 敏感信息（API Key / Token）严禁提交至 Git，.env 已在 .gitignore 中排除
# ============================================================================

# 阿里云百炼 API（通义千问，AI 解读层必填）；留空时自动回退 API_KEY_aliyun
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# 阿里云百炼兼容别名（可任选其一填写）
API_KEY_aliyun=

# DeepSeek API（备用大模型，可选）
API_KEY_Deepseek=

# 微信推送服务（PushPlus，通知层必填，否则推送降级为控制台输出）
PUSHPLUS_TOKEN=your_pushplus_token_here

# 模拟总资产（用于计算模拟仓位，单位：元）
SIMULATED_TOTAL_CAPITAL=1000000
